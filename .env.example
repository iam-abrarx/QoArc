# GEMINI_API_KEY: Required for Gemini AI API calls.
# If used in an API route (server-side), no prefix is needed.
# If used directly in a client component, prefix with NEXT_PUBLIC_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Prefix with NEXT_PUBLIC_ if accessed on the client.
NEXT_PUBLIC_APP_URL="https://www.qoarc.com"

# DATABASE_URL: Supabase PostgreSQL connection string.
# Use the TRANSACTION POOLER string (Supabase dashboard → Project Settings →
# Database → Connection string → "Transaction pooler"): host ends in
# ".pooler.supabase.com", port 6543, user "postgres.<project-ref>".
# Do NOT use the direct db.<ref>.supabase.co:5432 string for serverless.
# Set this in Vercel project settings for production (and here for local dev).
DATABASE_URL="postgresql://postgres.<ref>:password@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# BLOB_READ_WRITE_TOKEN: Vercel Blob storage token for image uploads.
# Set this in Vercel project settings for production.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ADMIN_PASSWORD: Password for the /admin dashboard. Server-side only (no
# NEXT_PUBLIC_ prefix) so it is never shipped to the browser. Use a strong value.
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# SESSION_SECRET: Secret key used to sign admin session cookies (min 16 chars).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-secret"
